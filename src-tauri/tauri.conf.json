{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Home Energy Manager",
  "mainBinaryName": "givenergy-local",
  "version": "0.83.7",
  "identifier": "com.givenergy.local",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:desktop && npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Home Energy Manager",
        "width": 950,
        "height": 970,
        "x": 0,
        "y": 0,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "enableGTKAppId": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "resources": {
      "../dist": "dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "librsvg2-2",
          "curl"
        ],
        "provides": [
          "giv-energy-local"
        ],
        "conflicts": [
          "giv-energy-local"
        ],
        "replaces": [
          "giv-energy-local"
        ],
        "postInstallScript": "deb/postinst.sh",
        "postRemoveScript": "deb/postrm.sh",
        "files": {
          "/usr/share/givenergy-local/dist": "../dist",
          "/usr/share/givenergy-local/proxmox-install.sh": "../scripts/proxmox/install.sh",
          "/usr/share/givenergy-local/givenergy-local-update.sh": "../scripts/pi/givenergy-local-update.sh",
          "/usr/lib/systemd/system/givenergy-local-update.service": "../scripts/pi/systemd/givenergy-local-update.service",
          "/usr/lib/systemd/system/givenergy-local-update.timer": "../scripts/pi/systemd/givenergy-local-update.timer"
        }
      },
      "rpm": {
        "provides": [
          "GivEnergy-Local"
        ],
        "conflicts": [
          "GivEnergy-Local"
        ],
        "obsoletes": [
          "GivEnergy-Local"
        ],
        "files": {
          "/usr/share/givenergy-local/dist": "../dist"
        }
      }
    }
  }
}
